// =======================================================================
// ISRs
// =======================================================================

void IRAM_ATTR leftHallISR() {
    unsigned long now = micros();
    if ((now - lastLeftAcceptedPulse) < HALL_DEBOUNCE_US) return;
    lastLeftAcceptedPulse = now;
    g_leftSignedCount += g_leftWheelDir;
}

void IRAM_ATTR rightHallISR() {
    unsigned long now = micros();
    if ((now - lastRightAcceptedPulse) < HALL_DEBOUNCE_US) return;
    lastRightAcceptedPulse = now;
    g_rightSignedCount += g_rightWheelDir;
}


// =======================================================================
// Math Helpers
// =======================================================================

static float wrapAngle(float a) {
    while (a >  PI) a -= 2.0f * PI;
    while (a < -PI) a += 2.0f * PI;
    return a;
}

float distanceToWaypoint(float x, float y, waypoint wp) {
    float dx = wp.x - x, dy = wp.y - y;
    return sqrtf(dx*dx + dy*dy);
}

float desiredHeading(float x, float y, waypoint wp) {
    return atan2f(wp.y - y, wp.x - x);
}


// =======================================================================
// Path Generation (from Sketch 1)
// =======================================================================

void generateMowingPath(float width, float height) {
    num_waypoints  = 0;
    waypoint_index = 0;
    float step = 0.4f;
    bool up = true;

    for (float x = 0.5f + step; x < width; x += step) {
        if (num_waypoints >= MAX_WAYPOINTS - 2) break;
        nav_waypoints[num_waypoints++] = {x, up ? 0.5f : height - 0.5f};
        nav_waypoints[num_waypoints++] = {x, up ? height - 0.5f : 0.5f};
        up = !up;
    }

    Serial.printf("[PATH] Generated %d waypoints for %.1fm x %.1fm field\n",
                  num_waypoints, width, height);
    WebSerial.printf("[PATH] %d waypoints, %.1fx%.1fm\n",
                     num_waypoints, width, height);
}


// =======================================================================
// Movement  — Sketch 2 version with MAX_DUTY scaling
// =======================================================================

void moveFunction(int action, int speed) {
    if (obstacleStop && action != STOP) return;

    int pwm = (speed * MAX_DUTY) / 100;

    switch (action) {
        case FORWARD:
            ledcWrite(LEFT_IN1,  pwm); digitalWrite(LEFT_IN2,  HIGH);
            ledcWrite(RIGHT_IN1, pwm); digitalWrite(RIGHT_IN2, HIGH);
            g_leftWheelDir  = WHEEL_FWD;
            g_rightWheelDir = WHEEL_FWD;
            break;

        case BACKWARD:
            ledcWrite(LEFT_IN1,  pwm); digitalWrite(LEFT_IN2,  LOW);
            ledcWrite(RIGHT_IN1, pwm); digitalWrite(RIGHT_IN2, LOW);
            g_leftWheelDir  = WHEEL_REV;
            g_rightWheelDir = WHEEL_REV;
            break;

        case LEFT:
            ledcWrite(LEFT_IN1,  pwm + TURN_BIAS); digitalWrite(LEFT_IN2,  LOW);
            ledcWrite(RIGHT_IN1, pwm + TURN_BIAS); digitalWrite(RIGHT_IN2, HIGH);
            g_leftWheelDir  = WHEEL_REV;
            g_rightWheelDir = WHEEL_FWD;
            break;

        case RIGHT:
            ledcWrite(LEFT_IN1,  pwm + TURN_BIAS); digitalWrite(LEFT_IN2,  HIGH);
            ledcWrite(RIGHT_IN1, pwm + TURN_BIAS); digitalWrite(RIGHT_IN2, LOW);
            g_leftWheelDir  = WHEEL_FWD;
            g_rightWheelDir = WHEEL_REV;
            break;

        case STOP:
        default:
            ledcWrite(LEFT_IN1,  0); digitalWrite(LEFT_IN2,  LOW);
            ledcWrite(RIGHT_IN1, 0); digitalWrite(RIGHT_IN2, LOW);
            g_leftWheelDir  = WHEEL_STOP;
            g_rightWheelDir = WHEEL_STOP;
            break;
    }
}


// =======================================================================
// Dead Reckoning  — Sketch 2 logic, mutex-protected writes
// =======================================================================

void updateDeadReckoning() {
    int32_t leftCount, rightCount;
    noInterrupts();
    leftCount  = g_leftSignedCount;
    rightCount = g_rightSignedCount;
    interrupts();

    int32_t dLeft  = leftCount  - g_est.last_left_count;
    int32_t dRight = rightCount - g_est.last_right_count;
    g_est.last_left_count  = leftCount;
    g_est.last_right_count = rightCount;

    if (dLeft == 0 && dRight == 0) return;

    float sLeft    = float(dLeft)  * LEFT_METERS_PER_PULSE;
    float sRight   = float(dRight) * RIGHT_METERS_PER_PULSE;
    float dCenter  = 0.5f * (sLeft + sRight);
    float dTheta   = (sRight - sLeft) / g_wheelBase;
    float thetaMid = g_est.est_heading + 0.5f * dTheta;

    xSemaphoreTake(g_posMutex, portMAX_DELAY);
    g_est.est_x       += dCenter * cosf(thetaMid);
    g_est.est_y       += dCenter * sinf(thetaMid);
    g_est.est_heading  = wrapAngle(g_est.est_heading + dTheta);
    xSemaphoreGive(g_posMutex);
}


// =======================================================================
// UWB Fusion  — Sketch 2 weighted-average + soft-gain correction
// =======================================================================

bool computeWeightedPosition(float &x_out, float &y_out) {
    xSemaphoreTake(g_posMutex, portMAX_DELAY);
    if (g_posCount <= 0) { xSemaphoreGive(g_posMutex); return false; }

    float sumW = 0, sumX = 0, sumY = 0;
    for (int k = 0; k < g_posCount; k++) {
        int   idx = (g_posHead - 1 - k + SAMPLE_COUNT) % SAMPLE_COUNT;
        float w   = float(g_posCount - k);   // newest sample has highest weight
        sumW += w;
        sumX += posBuffer[idx].x * w;
        sumY += posBuffer[idx].y * w;
    }
    xSemaphoreGive(g_posMutex);

    x_out = sumX / sumW;
    y_out = sumY / sumW;
    return true;
}

void correctEstimateWithUWB() {
    float uwbX, uwbY;
    if (!computeWeightedPosition(uwbX, uwbY)) return;

    g_est.uwb_x = uwbX;
    g_est.uwb_y = uwbY;

    xSemaphoreTake(g_posMutex, portMAX_DELAY);
    g_est.est_x = (1.0f - UWB_CORRECTION_GAIN) * g_est.est_x + UWB_CORRECTION_GAIN * uwbX;
    g_est.est_y = (1.0f - UWB_CORRECTION_GAIN) * g_est.est_y + UWB_CORRECTION_GAIN * uwbY;
    xSemaphoreGive(g_posMutex);
}

static bool acceptPositionMeasurement(const PositionPacket &p) {
    float dx   = p.x - g_robot.x_m;
    float dy   = p.y - g_robot.y_m;
    float disp = sqrtf(dx*dx + dy*dy);

    uint32_t dt_ms   = p.t_ms - g_robot.last_uwb_ms;
    float maxAllowed = MAX_SPEED_MPS * (dt_ms * 0.001f) + UWB_GATE_MARGIN_M;
    if (maxAllowed < MIN_UWB_GATE_M) maxAllowed = MIN_UWB_GATE_M;

    return disp <= maxAllowed;
}

void initPositionEstimator() {
    uint32_t now = millis();

    g_est.uwb_x       = START_X;  g_est.uwb_y       = START_Y;
    g_est.est_x       = START_X;  g_est.est_y       = START_Y;
    g_est.est_heading = 1.5708f;
    g_est.last_left_count  = 0;
    g_est.last_right_count = 0;
    g_est.last_update_ms   = now;

    for (int i = 0; i < SAMPLE_COUNT; i++)
        posBuffer[i] = {START_X, START_Y, now};

    g_robot      = {START_X, START_Y, now};
    g_posHead    = 0;
    g_posCount   = SAMPLE_COUNT;
}


// =======================================================================
// Navigation  — Sketch 2 proportional steering
// =======================================================================

void navigateToWaypoint(float x, float y, float heading) {
    if (waypoint_index >= num_waypoints) return;

    waypoint wp   = nav_waypoints[waypoint_index];
    float desired = desiredHeading(x, y, wp);
    float error   = wrapAngle(desired - heading);
    float absErr  = fabsf(error);

    int turnSpeed = 120 + (int)((absErr / PI) * (225 - 120));
    if (turnSpeed > 225) turnSpeed = 225;

    if      (absErr < 0.1f) moveFunction(FORWARD, 225);
    else if (error  > 0.0f) moveFunction(LEFT,    turnSpeed);
    else                    moveFunction(RIGHT,   turnSpeed);
}


// =======================================================================
// ESP-NOW
// =======================================================================

static void onReceive(const esp_now_recv_info *info,
                      const uint8_t *incomingData, int len) {
    (void)info;
    if (!incomingData || len < (int)sizeof(PositionPacket) || !g_posQueue) return;

    PositionPacket p;
    memcpy(&p, incomingData, sizeof(p));

    BaseType_t woken = pdFALSE;
    xQueueSendFromISR(g_posQueue, &p, &woken);
    if (woken) portYIELD_FROM_ISR();
}

static void initEspNow() {
    if (esp_now_init() != ESP_OK) {
        Serial.println("[ESP-NOW] Init failed — halting");
        while (true) delay(1000);
    }
    esp_now_register_recv_cb(onReceive);
    Serial.println("[ESP-NOW] Initialized.");
}


