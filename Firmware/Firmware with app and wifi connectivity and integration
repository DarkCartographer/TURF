// =======================================================================
// REST API  (from Sketch 1)
// =======================================================================

void setupAPI() {

    // GET /api/status — full telemetry for React Native app
    server.on("/api/status", HTTP_GET, [](AsyncWebServerRequest *req) {
        AsyncResponseStream *res = req->beginResponseStream("application/json");
        JsonDocument d;

        xSemaphoreTake(g_posMutex, portMAX_DELAY);
        d["x"]       = g_est.est_x;
        d["y"]       = g_est.est_y;
        d["heading"] = g_est.est_heading;
        xSemaphoreGive(g_posMutex);

        d["isMowing"]      = g_isMowing;
        d["batteryLevel"]  = 100;          // placeholder
        d["waypointIndex"] = waypoint_index;
        d["numWaypoints"]  = num_waypoints;
        d["obstacleStop"]  = (bool)obstacleStop;
        d["wheelbase"]     = g_wheelBase;

        serializeJson(d, *res);
        req->send(res);
    });

    // POST /api/command
    server.on("/api/command", HTTP_POST,
    [](AsyncWebServerRequest *req){}, NULL,
    [](AsyncWebServerRequest *req, uint8_t *data,
       size_t len, size_t index, size_t total) {

        if (index + len != total) return;

        JsonDocument d;
        deserializeJson(d, data);

        String raw; serializeJson(d, raw);
        Serial.println("[API] /command → " + raw);
        WebSerial.println("[API] cmd: " + raw);

        if (!d.containsKey("command")) {
            req->send(400, "application/json", "{\"error\":\"missing command\"}");
            return;
        }

        String c = d["command"].as<String>();
        c.trim(); c.toLowerCase();

        if (c == "resume") {
            obstacleStop = false;
            g_isMowing   = true;
            g_state      = STATE_DRIVING;
            Serial.println("[CMD] Resume mowing");
            WebSerial.println("[CMD] Resuming");
        }
        else if (c == "pause") {
            g_isMowing = false;
            moveFunction(STOP, 0);
            Serial.println("[CMD] Paused");
            WebSerial.println("[CMD] Paused");
        }
        else if (c == "calibrate") {
            g_state    = STATE_CALIBRATING;
            g_isMowing = true;
            moveFunction(RIGHT, 150);
            Serial.println("[CMD] Calibration spin started");
            WebSerial.println("[CMD] Calibrating...");
        }
        else if (c == "emergency_stop") {
            g_isMowing   = false;
            obstacleStop = true;
            moveFunction(STOP, 0);
            Serial.println("[CMD] *** EMERGENCY STOP ***");
            WebSerial.println("[CMD] *** EMERGENCY STOP ***");
        }
        else {
            Serial.println("[CMD] Unknown command: " + c);
        }

        req->send(200, "application/json", "{\"success\":true}");
    });

    // POST /api/settings — update wheelbase at runtime
    server.on("/api/settings", HTTP_POST,
    [](AsyncWebServerRequest *req){}, NULL,
    [](AsyncWebServerRequest *req, uint8_t *data,
       size_t len, size_t index, size_t total) {

        if (index + len != total) return;

        JsonDocument d;
        deserializeJson(d, data);

        if (d.containsKey("wheelbase")) {
            g_wheelBase = d["wheelbase"].as<float>();
            g_state     = STATE_IDLE;
            moveFunction(STOP, 0);
            Serial.printf("[SETTINGS] Wheelbase → %.4fm\n", g_wheelBase);
            WebSerial.printf("Wheelbase updated: %.4fm\n", g_wheelBase);
        }

        req->send(200, "application/json", "{\"success\":true}");
    });

    // POST /api/field-config — set field dimensions & regenerate path
    server.on("/api/field-config", HTTP_POST,
    [](AsyncWebServerRequest *req){}, NULL,
    [](AsyncWebServerRequest *req, uint8_t *data,
       size_t len, size_t index, size_t total) {

        if (index + len != total) return;

        JsonDocument d;
        deserializeJson(d, data);

        if (d.containsKey("dimensions")) {
            g_fieldWidth  = d["dimensions"]["width"].as<float>();
            g_fieldHeight = d["dimensions"]["height"].as<float>();
            generateMowingPath(g_fieldWidth, g_fieldHeight);
            Serial.printf("[FIELD] %.1fm x %.1fm → %d waypoints\n",
                          g_fieldWidth, g_fieldHeight, num_waypoints);
            WebSerial.printf("Field %.1fx%.1f, %d wps\n",
                             g_fieldWidth, g_fieldHeight, num_waypoints);
        }

        req->send(200, "application/json", "{\"success\":true}");
    });

    DefaultHeaders::Instance().addHeader("Access-Control-Allow-Origin", "*");
    server.begin();
    Serial.println("[API] Server started on port 80.");
}


// =======================================================================
// Setup
// =======================================================================

void setup() {
    Serial.begin(115200);
    SPI.begin(14, 12, 13, PIN_SS);
    delay(200);

    // --- GPIO ---
    pinMode(US_TRIG_PIN,    OUTPUT);
    pinMode(US_ECHO_PIN,    INPUT);
    pinMode(LEFT_IN2,       OUTPUT);
    pinMode(RIGHT_IN2,      OUTPUT);
    ledcAttach(LEFT_IN1,    PWM_FREQ, PWM_RES);
    ledcAttach(RIGHT_IN1,   PWM_FREQ, PWM_RES);
    pinMode(LEFT_HALL_PIN,  INPUT_PULLUP);
    pinMode(RIGHT_HALL_PIN, INPUT_PULLUP);
    attachInterrupt(digitalPinToInterrupt(LEFT_HALL_PIN),  leftHallISR,  RISING);
    attachInterrupt(digitalPinToInterrupt(RIGHT_HALL_PIN), rightHallISR, RISING);

    // --- Synchronization primitives ---
    g_posMutex = xSemaphoreCreateMutex();
    g_posQueue = xQueueCreate(10, sizeof(PositionPacket));
    if (!g_posQueue) {
        Serial.println("[SETUP] ERROR: Queue creation failed — halting");
        while (true) delay(1000);
    }

    // --- Initial position state ---
    initPositionEstimator();

    // --- DW1000 (needed even with UWB task disabled — keeps hardware init consistent) ---
    initDw1000();

    // --- WiFi (AP+STA required for ESP-NOW) ---
    WiFi.mode(WIFI_AP_STA);
    WiFi.begin(SSID, PASSPHRASE);
    Serial.print("[WiFi] Connecting");
    while (WiFi.status() != WL_CONNECTED) { delay(500); Serial.print("."); }
    Serial.println("\n[WiFi] IP: " + WiFi.localIP().toString());

    // --- ESP-NOW ---
    initEspNow();

    // --- WebSerial + REST API ---
    WebSerial.begin(&server);
    setupAPI();

    // --- Default mowing path (overridden at runtime via /api/field-config) ---
    generateMowingPath(g_fieldWidth, g_fieldHeight);

    // --- FreeRTOS Tasks ---
    xTaskCreatePinnedToCore(PositionUpdateTask, "PosUpdate",  4096, NULL, 2, NULL, 1);
    xTaskCreatePinnedToCore(ultrasonicTask,     "Ultrasonic", 4096, NULL, 1, NULL, 1);
    xTaskCreatePinnedToCore(odometryTask,       "Odometry",   4096, NULL, 4, NULL, 1);
    // uwbTask intentionally not started — see commented task above

    Serial.println("[SETUP] Complete. Awaiting API commands.");
    WebSerial.println("System ready. POST resume to /api/command to start.");
}

void loop() { vTaskDelete(NULL); }
