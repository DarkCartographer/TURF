void generateMowingPath(float width, float height) {
    float cut_width = 0.3f; 
    float margin = 0.2f;    
    num_waypoints = 0;
    waypoint_index = 0;
    bool moving_up = true;
    
    for (float x = margin; x <= (width - margin); x += cut_width) {
        if (num_waypoints >= MAX_WAYPOINTS - 2) break;
        if (moving_up) {
            nav_waypoints[num_waypoints++] = {x, margin};
            nav_waypoints[num_waypoints++] = {x, height - margin};
        } else {
            nav_waypoints[num_waypoints++] = {x, height - margin};
            nav_waypoints[num_waypoints++] = {x, margin};
        }
        moving_up = !moving_up;
    }
}

// --- Wheelbase Calibration ---
// Robot should spin exactly 360 degrees in place for measurement
void calibrateTurnRadius() {
    // Reset pulse counts safely
    noInterrupts();
    g_leftPulseCount = 0;
    g_rightPulseCount = 0;
    interrupts();

    // Spin for a fixed number of pulses
    const uint32_t TARGET_PULSES = 200;
    WebSerial.println("Starting calibration spin...");
    moveFunction(RIGHT, 80);

    while(true) {
        noInterrupts();
        uint32_t lp = g_leftPulseCount;
        uint32_t rp = g_rightPulseCount;
        interrupts();

        if(lp >= TARGET_PULSES && rp >= TARGET_PULSES)
            break;

        vTaskDelay(pdMS_TO_TICKS(10));
    }

    moveFunction(STOP, 0);

    WebSerial.printf("Calibration Complete. Left: %lu  Right: %lu pulses\n", 
                     g_leftPulseCount, g_rightPulseCount);
    WebSerial.println("Measure actual rotation degrees to calculate effective wheelbase.");
}

// --- Navigation Logic ---
// Returns TRUE when the robot successfully reaches the target coordinates
bool navigateToWaypoint(float x, float y, float heading) {
    // Throttle navigation updates to avoid overwhelming the motor controllers
    if(millis() - lastNavUpdate < 100) return false;  
    lastNavUpdate = millis();

    waypoint wp = nav_waypoints[waypoint_index];
    
    // Calculate distance to the target using the Pythagorean theorem
    float dist = sqrt(pow(wp.x - x, 2) + pow(wp.y - y, 2));

    if(dist < 0.25f) { 
        return true; // We arrived! Trigger the state machine to stop and settle.
    }

    // Calculate desired heading using arc-tangent
    float desired = atan2(wp.y - y, wp.x - x);
    float error = desired - heading;
    
    // Normalize the angle to keep the math within standard circular bounds
    while (error > PI) error -= 2 * PI;
    while (error < -PI) error += 2 * PI;
    float absError = fabs(error);

    // If facing the wrong way, stop and rotate in place
    if(absError > 0.25f) { // ~14 degrees of error
        
        // Proportional speed that scales DOWN as error shrinks
        const int MIN_TURN = 70;   // Minimum power to overcome grass friction
        const int MAX_TURN = 160;  // Maximum power to prevent spinning out
        
        float t = (absError - 0.25f) / (PI - 0.25f); 
        t = constrain(t, 0.0f, 1.0f);
        int turnSpeed = MIN_TURN + (int)(t * (MAX_TURN - MIN_TURN));

        // Brief stop before turning reduces chassis rocking momentum
        moveFunction(STOP, 0);      
        vTaskDelay(pdMS_TO_TICKS(30)); 

        if(error > 0)
            moveFunction(LEFT, turnSpeed);
        else
            moveFunction(RIGHT, turnSpeed);
    }
    else {
        // Heading is roughly correct: drive forward with gentle differential correction
        const int BASE_SPEED = 200;
        const float STEER_GAIN = 40.0f;
        int correction = (int)(error * STEER_GAIN);

        // Clamp the correction so one wheel doesn't stop completely
        correction = constrain(correction, -60, 60);

        int leftSpeed  = BASE_SPEED - correction;
        int rightSpeed = BASE_SPEED + correction;

        // Apply differential drive directly to the motor driver pins
        int leftPwm  = constrain((leftSpeed  * MAX_DUTY) / 100, 0, MAX_DUTY);
        int rightPwm = constrain((rightSpeed * MAX_DUTY) / 100, 0, MAX_DUTY);

        g_leftWheelDir  = WHEEL_FWD;
        g_rightWheelDir = WHEEL_FWD;

        analogWrite(LEFT_IN1,  leftPwm);
        analogWrite(LEFT_IN2,  0);
        analogWrite(RIGHT_IN1, rightPwm);
        analogWrite(RIGHT_IN2, 0);
    }
    
    return false;
}

void moveFunction(int action, int speed) {
    if(obstacleStop && action != STOP) return;
    int pwm = (speed * MAX_DUTY) / 100;

    switch (action) {
        case FORWARD:
            g_leftWheelDir = WHEEL_FWD; g_rightWheelDir = WHEEL_FWD;
            analogWrite(LEFT_IN1, pwm); analogWrite(LEFT_IN2, 0);
            analogWrite(RIGHT_IN1, pwm); analogWrite(RIGHT_IN2, 0);
            break;
        case LEFT:
            g_leftWheelDir = WHEEL_REV; g_rightWheelDir = WHEEL_FWD;
            analogWrite(LEFT_IN1, 0); analogWrite(LEFT_IN2, pwm);
            analogWrite(RIGHT_IN1, pwm); analogWrite(RIGHT_IN2, 0);
            break;
        case RIGHT:
            g_leftWheelDir = WHEEL_FWD; g_rightWheelDir = WHEEL_REV;
            analogWrite(LEFT_IN1, pwm); analogWrite(LEFT_IN2, 0);
            analogWrite(RIGHT_IN1, 0); analogWrite(RIGHT_IN2, pwm);
            break;
        case STOP:
        default:
            g_leftWheelDir = WHEEL_STOP; g_rightWheelDir = WHEEL_STOP;
            analogWrite(LEFT_IN1, 0); analogWrite(LEFT_IN2, 0);
            analogWrite(RIGHT_IN1, 0); analogWrite(RIGHT_IN2, 0);
            break;
    }
}

// --- Positioning Tasks ---
void updateDeadReckoning() {
    uint32_t leftCount, rightCount;
    int8_t leftDir, rightDir;

    noInterrupts();
    leftCount = g_leftPulseCount; rightCount = g_rightPulseCount;
    leftDir = g_leftWheelDir; rightDir = g_rightWheelDir;
    interrupts();

    int32_t dLeft = (int32_t)leftCount - (int32_t)g_est.last_left_count;
    int32_t dRight = (int32_t)rightCount - (int32_t)g_est.last_right_count;

    g_est.last_left_count = leftCount;
    g_est.last_right_count = rightCount;

    if(dLeft == 0 && dRight == 0) return;

    float sLeft = float(dLeft) * METERS_PER_PULSE * float(leftDir);
    float sRight = float(dRight) * METERS_PER_PULSE * float(rightDir);

    float dCenter = 0.5f * (sLeft + sRight);
    float dTheta = (sRight - sLeft) / WHEEL_BASE_M;
    float thetaMid = g_est.est_heading + 0.5f * dTheta;

    g_est.est_x += dCenter * cosf(thetaMid);
    g_est.est_y += dCenter * sinf(thetaMid);
    g_est.est_heading = g_est.est_heading + dTheta;
    while (g_est.est_heading > PI) g_est.est_heading -= 2 * PI;
    while (g_est.est_heading < -PI) g_est.est_heading += 2 * PI;
}

void correctEstimateWithUWB() {
    float uwbX, uwbY;

    // Averages the last 10 UWB packets from the buffer
    if(!computeWeightedPosition(uwbX, uwbY)) return;

    g_est.uwb_x = uwbX;
    g_est.uwb_y = uwbY;

    // Overwrite the drifting dead reckoning calculation with the true UWB location
    g_est.est_x = (1.0f - UWB_CORRECTION_GAIN) * g_est.est_x + UWB_CORRECTION_GAIN * uwbX;
    g_est.est_y = (1.0f - UWB_CORRECTION_GAIN) * g_est.est_y + UWB_CORRECTION_GAIN * uwbY;
}

bool computeWeightedPosition(float &x_out, float &y_out) {
    xSemaphoreTake(g_posMutex, portMAX_DELAY);
    if(g_posCount <= 0) {
        xSemaphoreGive(g_posMutex);
        return false;
    }

    float sumW = 0.0f;
    float sumX = 0.0f;
    float sumY = 0.0f;

    for(int k = 0; k < g_posCount; k++) {
        int idx = (g_posHead - 1 - k + SAMPLE_COUNT) % SAMPLE_COUNT;
        float w = float(g_posCount - k); 
        sumW += w;
        sumX += posBuffer[idx].x * w;
        sumY += posBuffer[idx].y * w;
    }
    xSemaphoreGive(g_posMutex);

    x_out = sumX / sumW;
    y_out = sumY / sumW;
    return true;
}

static void odometryTask(void *param) {
    for(;;) {
        updateDeadReckoning();

        if (g_isMowing && !obstacleStop) {
            
            // Wake the robot up if the app sends the Resume command
            if (g_state == STATE_IDLE) {
                g_state = STATE_DRIVING;
            }

            switch (g_state) {
                
                case STATE_DRIVING:
                    // Continuously returns true when the target is hit
                    if (navigateToWaypoint(g_est.est_x, g_est.est_y, g_est.est_heading)) {
                        moveFunction(STOP, 0);
                        WebSerial.println("Row complete. Settling chassis...");
                        g_state = STATE_SETTLING;
                        g_stateTimer = millis();
                    }
                    break;

                case STATE_SETTLING:
                    moveFunction(STOP, 0);
                    // Wait 1 second for physical bouncing to stop
                    if (millis() - g_stateTimer > 1000) { 
                        WebSerial.println("Taking stationary UWB measurements...");
                        g_state = STATE_CORRECTING;
                        g_stateTimer = millis();
                    }
                    break;

                case STATE_CORRECTING:
                    moveFunction(STOP, 0);
                    // Wait 1.5 seconds to gather clean, averaged UWB radio packets
                    if (millis() - g_stateTimer > 1500) { 
                        correctEstimateWithUWB();
                        WebSerial.println("Position corrected via UWB.");
                        
                        waypoint_index++;
                        if (waypoint_index >= num_waypoints) {
                            g_isMowing = false;
                            g_state = STATE_IDLE;
                            WebSerial.println("All waypoints complete.");
                        } else {
                            g_state = STATE_DRIVING;
                            WebSerial.println("Starting next row.");
                        }
                    }
                    break;

                case STATE_CALIBRATING:
                    calibrateTurnRadius();
                    g_isMowing = false;
                    g_state = STATE_IDLE;
                    break;

                default:
                    break;
            }
        } else {
            // Failsafe: Ensure motors are dead if mowing is paused or an obstacle is hit
            moveFunction(STOP, 0);
            g_state = STATE_IDLE;
        }
        vTaskDelay(pdMS_TO_TICKS(20));
    }
}

// --- Radio Updates ---
static void onReceive(const uint8_t *mac_addr, const uint8_t *incomingData, int len) {
    if (!incomingData || len < (int)sizeof(PositionPacket) || !g_posQueue) return;
    PositionPacket p;
    memcpy(&p, incomingData, sizeof(p));
    xQueueSendFromISR(g_posQueue, &p, NULL);
}

static void PositionUpdateTask(void *param) {
    (void)param;
    PositionPacket p;
    for (;;) {
        if (xQueueReceive(g_posQueue, &p, portMAX_DELAY) == pdTRUE) {
            g_robot.x_m = p.x;
            g_robot.y_m = p.y;
            g_robot.last_uwb_ms = p.t_ms;

            // Simply record the UWB data to the buffer. Do NOT trigger a correction.
            xSemaphoreTake(g_posMutex, portMAX_DELAY);
            posBuffer[g_posHead].x = p.x;
            posBuffer[g_posHead].y = p.y;
            posBuffer[g_posHead].t_ms = p.t_ms;

            g_posHead = (g_posHead + 1) % SAMPLE_COUNT;
            if(g_posCount < SAMPLE_COUNT) g_posCount++;
            xSemaphoreGive(g_posMutex);
        }
    }
}

// --- Setup ---
void setup() {
    Serial.begin(115200);
    SPI.begin(14, 32, 13, PIN_SS); 
    delay(200);

    pinMode(US_TRIG_PIN, OUTPUT); pinMode(US_ECHO_PIN, INPUT);
    pinMode(LEFT_IN1, OUTPUT); pinMode(LEFT_IN2, OUTPUT);
    pinMode(RIGHT_IN1, OUTPUT); pinMode(RIGHT_IN2, OUTPUT);
    pinMode(LEFT_HALL_PIN, INPUT_PULLUP); pinMode(RIGHT_HALL_PIN, INPUT_PULLUP);

    attachInterrupt(digitalPinToInterrupt(LEFT_HALL_PIN), leftHallISR, RISING);
    attachInterrupt(digitalPinToInterrupt(RIGHT_HALL_PIN), rightHallISR, RISING);

    g_posMutex = xSemaphoreCreateMutex();
    g_posQueue = xQueueCreate(10, sizeof(PositionPacket));

    initDw1000();
    initEspNow();

    WiFi.begin(SSID, PASSPHRASE);
    while (WiFi.status() != WL_CONNECTED) { delay(500); Serial.print("."); }
    
    Serial.println("\nIP: " + WiFi.localIP().toString());

    // Application Programming Interface (API) Security configuration
    DefaultHeaders::Instance().addHeader("Access-Control-Allow-Origin", "*");
    
    server.on("/api/status", HTTP_GET, [](AsyncWebServerRequest *request){
        JsonDocument doc;
        doc["isMowing"] = g_isMowing;
        doc["batteryLevel"] = g_batteryLevel;
        doc["mowingProgress"] = g_mowingProgress;
        JsonObject pos = doc["position"].to<JsonObject>();
        pos["x"] = g_est.est_x; pos["y"] = g_est.est_y;
        String response; serializeJson(doc, response);
        request->send(200, "application/json", response);
    });

    server.on("/api/command", HTTP_POST, [](AsyncWebServerRequest *request){}, NULL, 
        [](AsyncWebServerRequest *request, uint8_t *data, size_t len, size_t index, size_t total){
            JsonDocument doc; deserializeJson(doc, data);
            String cmd = doc["command"];
            
            // App commands linked directly to the robot's state machine
            if (cmd == "resume") {
                g_isMowing = true;
            } else if (cmd == "pause") {
                g_isMowing = false;
            } else if (cmd == "calibrate") {
                g_state = STATE_CALIBRATING;
                g_isMowing = true; // Engage motor tasks
            }
            
            request->send(200, "application/json", "{\"success\":true}");
    });

    server.begin();

    // Start Real-Time Operating System (RTOS) Tasks
    xTaskCreatePinnedToCore(odometryTask, "Odom", 4096, NULL, 2, NULL, 1);
    xTaskCreatePinnedToCore(PositionUpdateTask, "PosUpdate", 4096, NULL, 2, NULL, 1);
    xTaskCreatePinnedToCore(uwbTask, "UWB", 8192, NULL, 3, NULL, 1);
}

