// --- Network & Hardware Identity ---
#define SSID "SAM-WINDOWS 9657"
#define PASSPHRASE "0H13{m56"
#define RTLS_APP_ID 10
const char EUI[] = "AA:BB:CC:DD:EE:FF:00:00"; // Extended Unique Identifier (EUI)

// --- Pin Definitions ---
static constexpr uint8_t PIN_RST = 27;
static constexpr uint8_t PIN_SS  = 4; // Slave Select (SS)

// Motor Pins (Shared GPIO 18/19 with Serial Peripheral Interface - SPI)
#define LEFT_IN1 21  
#define LEFT_IN2 22  
#define RIGHT_IN1 18  // Shared with SPI Serial Clock (SCK)
#define RIGHT_IN2 19  // Shared with SPI Master In Slave Out (MISO)

// Sensors
#define LEFT_HALL_PIN 32
#define RIGHT_HALL_PIN 25

// --- Strongly Typed Motion Enum ---
enum MoveAction {
    FORWARD,
    BACKWARD,
    LEFT,
    RIGHT,
    STOP
};

// --- Navigation & State ---
enum MowerState { 
    STATE_IDLE, 
    STATE_DRIVING, 
    STATE_SETTLING, 
    STATE_CORRECTING, 
    STATE_CALIBRATING 
};

static MowerState g_state = STATE_IDLE;
bool g_isMowing = false;
volatile bool obstacleStop = false;
bool g_uwbInitialized = false;

float g_wheelBase = 0.219075f;
float g_fieldWidth = 5.0f;
float g_fieldHeight = 5.0f;
#define MAX_DUTY 55 // Maximum Pulse Width Modulation (PWM) duty cycle
#define PWM_FREQ 20000 // Pulse Width Modulation frequency in Hertz
#define PWM_RES 8 // 8-bit resolution (0-255)

// --- Waypoints & Positioning ---
struct waypoint { float x; float y; };
#define MAX_WAYPOINTS 100
waypoint nav_waypoints[MAX_WAYPOINTS];
int waypoint_index = 0;
int num_waypoints = 0;

struct PositionEstimator {
    float x = 0.4f, y = 0.4f, heading = 0.0f;
};
PositionEstimator g_est; 
SemaphoreHandle_t g_posMutex; // Mutual Exclusion (Mutex) to prevent data corruption

volatile unsigned long g_leftPulseCount = 0, g_rightPulseCount = 0;
static volatile uint32_t g_blinkRateMs = 200;

// --- Motor Control Logic ---

void moveFunction(MoveAction action, int speed) {
    int pwm = (speed * MAX_DUTY) / 100;

    switch (action) {
        case FORWARD:
            ledcWrite(LEFT_IN1, pwm); digitalWrite(LEFT_IN2, HIGH);
            ledcWrite(RIGHT_IN1, pwm); digitalWrite(RIGHT_IN2, HIGH);
            break;
        case BACKWARD:
            ledcWrite(LEFT_IN1, pwm); digitalWrite(LEFT_IN2, LOW);
            ledcWrite(RIGHT_IN1, pwm); digitalWrite(RIGHT_IN2, LOW);
            break;
        case LEFT:
            // Differential Turn: Left back, Right forward
            ledcWrite(LEFT_IN1, pwm); digitalWrite(LEFT_IN2, LOW);
            ledcWrite(RIGHT_IN1, pwm); digitalWrite(RIGHT_IN2, HIGH);
            break;
        case RIGHT:
            // Differential Turn: Left forward, Right back
            ledcWrite(LEFT_IN1, pwm); digitalWrite(LEFT_IN2, HIGH);
            ledcWrite(RIGHT_IN1, pwm); digitalWrite(RIGHT_IN2, LOW);
            break;
        case STOP:
        default:
            ledcWrite(LEFT_IN1, 0); digitalWrite(LEFT_IN2, LOW);
            ledcWrite(RIGHT_IN1, 0); digitalWrite(RIGHT_IN2, LOW);
            break;
    }
}

// --- Navigation Functions ---

void generateMowingPath(float width, float height) {
    num_waypoints = 0;
    float step = 0.4f; // 40cm overlap
    bool up = true;
    for (float x = 0.5f; x < width; x += step) {
        if (num_waypoints >= MAX_WAYPOINTS - 2) break;
        nav_waypoints[num_waypoints++] = {x, up ? 0.5f : height - 0.5f};
        nav_waypoints[num_waypoints++] = {x, up ? height - 0.5f : 0.5f};
        up = !up;
    }
}

bool navigateToWaypoint() {
    xSemaphoreTake(g_posMutex, portMAX_DELAY);
    if (waypoint_index >= num_waypoints) { xSemaphoreGive(g_posMutex); return true; }
    
    waypoint wp = nav_waypoints[waypoint_index];
    float dx = wp.x - g_est.x;
    float dy = wp.y - g_est.y;
    float head = g_est.heading;
    xSemaphoreGive(g_posMutex);

    float dist = sqrt(dx*dx + dy*dy);
    if (dist < 0.25f) return true; // Waypoint reached

    // Heading calculation using tangent inverse (Trigonometry)
    float desiredHeading = atan2(dy, dx);
    float error = desiredHeading - head;
    
    // Normalize angle to ensure we turn the shortest way
    while (error > PI) error -= 2 * PI;
    while (error < -PI) error += 2 * PI;

    if (fabs(error) > 0.3f) {
        moveFunction(error > 0 ? LEFT : RIGHT, 75);
    } else {
        moveFunction(FORWARD, 85);
    }
    return false;
}

// --- Calibration Function ---
void calibrateTurnRadius() {
    Serial.println("\n=== CALIBRATION FUNCTION TRIGGERED ===");
    
    noInterrupts();
    g_leftPulseCount = 0;
    g_rightPulseCount = 0;
    interrupts();
    
    // Give motors the command to move
    moveFunction(RIGHT, 80); 
    
    // Wait 100 milliseconds to let the initial motor electrical noise settle
    vTaskDelay(pdMS_TO_TICKS(100)); 

    const uint32_t TARGET_PULSES = 450; 
    uint32_t startTime = millis();
    
    while(true) {
        // Print the sensor values to the Serial Monitor every 100ms
        Serial.printf("Sensors -> Left: %lu | Right: %lu\n", g_leftPulseCount, g_rightPulseCount);
        
        if(g_leftPulseCount >= TARGET_PULSES || g_rightPulseCount >= TARGET_PULSES) {
            Serial.println("Target pulses reached!");
            break;
        }

        // Safety Guard: Stop if it takes longer than 10 seconds
        if(millis() - startTime > 10000) {
            Serial.println("ERROR: 10-Second Timeout. Sensors might be disconnected.");
            break;
        }
        
        vTaskDelay(pdMS_TO_TICKS(100)); 
    } // End of the while loop

    moveFunction(STOP, 0);
    Serial.printf("=== CALIBRATION FINISHED IN %lu ms ===\n\n", millis() - startTime);
} // End of the function
// --- Square Test ---
void runSquareTest() {
    WebSerial.println("--- STARTING SQUARE TEST ---");
    
    const int sideDuration = 2000; // 2 seconds forward
    const int turnDuration = 1200; // Calculated duration for a 90-degree turn
    const int stopDuration = 500;  // Settling time

    for (int i = 0; i < 4; i++) {
        WebSerial.printf("Square Side %d\n", i + 1);
        
        moveFunction(FORWARD, 225);
        delay(sideDuration);
        
        moveFunction(STOP, 0);
        delay(stopDuration);
        
        moveFunction(RIGHT, 225);
        delay(turnDuration);
        
        moveFunction(STOP, 0);
        delay(stopDuration);
    }
    
    WebSerial.println("--- SQUARE TEST COMPLETE ---");
}

// --- Real-Time Operating System (RTOS) Tasks ---

static void uwbTask(void *param) {
    for (;;) {
        if (g_uwbInitialized && (g_state == STATE_SETTLING || g_state == STATE_IDLE)) {
            DW1000Ng::deepSleep();
            vTaskDelay(pdMS_TO_TICKS(g_blinkRateMs));
            DW1000Ng::spiWakeup();
            
            // Perform Two-Way Ranging (TWR)
            RangeInfrastructureResult res = DW1000NgRTLS::tagTwrLocalize(2000);
            
            if (res.success) {
                // X and Y coordinates are determined externally via anchors
                g_blinkRateMs = res.new_blink_rate;
            }
        }
        vTaskDelay(pdMS_TO_TICKS(50));
    }
}

static void odometryTask(void *param) {
    for (;;) {
        if (g_isMowing) {
            switch (g_state) {
                case STATE_IDLE: 
                    g_state = STATE_DRIVING; 
                    break;
                
                case STATE_DRIVING:
                    if (navigateToWaypoint()) {
                        moveFunction(STOP, 0);
                        g_state = STATE_SETTLING;
                    }
                    break;

                case STATE_SETTLING:
                    vTaskDelay(pdMS_TO_TICKS(1200)); 
                    g_state = STATE_CORRECTING;
                    break;

                case STATE_CORRECTING:
                    waypoint_index++;
                    if (waypoint_index >= num_waypoints) {
                        g_isMowing = false;
                        g_state = STATE_IDLE;
                        WebSerial.println("Mission: All Waypoints Complete.");
                    } else {
                        g_state = STATE_DRIVING;
                    }
                    break;

                case STATE_CALIBRATING:
                    calibrateTurnRadius();
                    g_isMowing = false;
                    g_state = STATE_IDLE;
                    break;
            }
        } else {
            moveFunction(STOP, 0);
        }
        vTaskDelay(pdMS_TO_TICKS(20));
    }
}

// --- Web Server Setup ---
AsyncWebServer server(80);

void setup() {
    Serial.begin(115200);
    g_posMutex = xSemaphoreCreateMutex();
    
    SPI.begin(18, 19, 23, PIN_SS); 

    // Light Emitting Diode Control (LEDC) utilized for Motor Pulse Width Modulation
    ledcAttach(LEFT_IN1, PWM_FREQ, PWM_RES);
    ledcAttach(RIGHT_IN1, PWM_FREQ, PWM_RES);
    pinMode(LEFT_IN2, OUTPUT); pinMode(RIGHT_IN2, OUTPUT);
    
    pinMode(LEFT_HALL_PIN, INPUT_PULLUP); pinMode(RIGHT_HALL_PIN, INPUT_PULLUP);
    attachInterrupt(digitalPinToInterrupt(LEFT_HALL_PIN), []{ g_leftPulseCount++; }, RISING);
    attachInterrupt(digitalPinToInterrupt(RIGHT_HALL_PIN), []{ g_rightPulseCount++; }, RISING);

    DW1000Ng::initializeNoInterrupt(PIN_SS, PIN_RST);
    g_uwbInitialized = true;
    
    generateMowingPath(5.0, 5.0); 

    WiFi.begin(SSID, PASSPHRASE);
    uint32_t startAttempt = millis();
    while (WiFi.status() != WL_CONNECTED && millis() - startAttempt < 10000) delay(500);

    // RESTful Application Programming Interface (API) Status stream
    server.on("/api/status", HTTP_GET, [](AsyncWebServerRequest *request){
        AsyncResponseStream *response = request->beginResponseStream("application/json");
        JsonDocument doc;
        xSemaphoreTake(g_posMutex, portMAX_DELAY);
        doc["isMowing"] = g_isMowing;
        doc["x"] = g_est.x; 
        doc["y"] = g_est.y;
        xSemaphoreGive(g_posMutex);
        serializeJson(doc, *response);
        request->send(response);
    });

    // RESTful API Settings Endpoint
    server.on("/api/settings", HTTP_POST, [](AsyncWebServerRequest *request){}, NULL, 
    [](AsyncWebServerRequest *request, uint8_t *data, size_t len, size_t index, size_t total){
        if (index + len == total) {
            JsonDocument doc; 
            DeserializationError error = deserializeJson(doc, data);
            
            if (!error) {
                // Read the incoming values if they exist in the payload
                if (doc.containsKey("wheelbase")) g_wheelBase = doc["wheelbase"].as<float>();
                if (doc.containsKey("fieldWidth")) g_fieldWidth = doc["fieldWidth"].as<float>();
                if (doc.containsKey("fieldHeight")) g_fieldHeight = doc["fieldHeight"].as<float>();
                
                // Regenerate the waypoints with the brand new dimensions
                generateMowingPath(g_fieldWidth, g_fieldHeight);
                
                Serial.printf("--- SETTINGS RECEIVED: WB=%.3f, W=%.1f, H=%.1f ---\n", 
                              g_wheelBase, g_fieldWidth, g_fieldHeight);
                              
                request->send(200, "application/json", "{\"success\":true}");
            } else {
                request->send(400, "application/json", "{\"error\":\"Parse Failed\"}");
            }
        }
    });

    server.on("/api/command", HTTP_POST, [](AsyncWebServerRequest *request){}, NULL, 
[](AsyncWebServerRequest *request, uint8_t *data, size_t len, size_t index, size_t total){
    if (index + len == total) {
        JsonDocument doc; 
        deserializeJson(doc, data);
        
        // 1. Force the type to String
        String cmd = doc["command"].as<String>();
        
        // 2. Strip hidden newlines/spaces and standardize case
        cmd.trim();
        cmd.toLowerCase();
        
        // 3. Print with brackets so hidden spaces become visible
        Serial.println("--- API RECEIVED: [" + cmd + "] ---");

        if (cmd == "resume") { 
            g_isMowing = true; 
            g_state = STATE_DRIVING; 
            obstacleStop = false; // Unlock motors
        } else if (cmd == "pause") { 
            g_isMowing = false; 
        } else if (cmd == "calibrate") { 
            g_state = STATE_CALIBRATING; 
            g_isMowing = true; 
            Serial.println("--- STATE SET TO CALIBRATING ---"); 
        } else if (cmd == "emergency_stop") {
            g_isMowing = false;
            g_state = STATE_IDLE;
            obstacleStop = true; // Lock motors immediately
            moveFunction(STOP, 0); // Cut power
            Serial.println("--- EMERGENCY STOP ACTIVATED ---");
        } else {
            Serial.println("--- ERROR: Unrecognized Command ---");
        }
        request->send(200, "application/json", "{\"success\":true}");
    }
    });
    // Dedicated endpoint for the Field Configuration button
    server.on("/api/field-config", HTTP_POST, [](AsyncWebServerRequest *request){}, NULL, 
    [](AsyncWebServerRequest *request, uint8_t *data, size_t len, size_t index, size_t total){
        if (index + len == total) {
            JsonDocument doc; 
            DeserializationError error = deserializeJson(doc, data);
            
            if (!error) {
                // Read the incoming dimensions
                if (doc.containsKey("fieldWidth")) g_fieldWidth = doc["fieldWidth"].as<float>();
                if (doc.containsKey("fieldHeight")) g_fieldHeight = doc["fieldHeight"].as<float>();
                
                // Regenerate the grid with the new dimensions
                generateMowingPath(g_fieldWidth, g_fieldHeight);
                
                Serial.printf("--- FIELD CONFIG SAVED: Width=%.1f, Height=%.1f ---\n", 
                              g_fieldWidth, g_fieldHeight);
                              
                request->send(200, "application/json", "{\"success\":true}");
            } else {
                request->send(400, "application/json", "{\"error\":\"Parse Failed\"}");
            }
        }
    });
// The Catch-All handler for undefined URLs
    server.onNotFound([](AsyncWebServerRequest *request) {
        String method = (request->method() == HTTP_GET) ? "GET" : "POST";
        String url = request->url();
        
        Serial.println("\n--- 404 NOT FOUND ERROR ---");
        Serial.println("The app tried to reach: " + url);
        Serial.println("Using HTTP Method: " + method);
        Serial.println("---------------------------\n");
        
        request->send(404, "text/plain", "Endpoint not found");
    });
    server.begin();
    
  //  runSquareTest();
    g_isMowing = false;

    // Launch background execution loops (Tasks)
    xTaskCreatePinnedToCore(odometryTask, "Odom", 4096, NULL, 2, NULL, 1);
    xTaskCreatePinnedToCore(uwbTask, "UWB", 8192, NULL, 3, NULL, 1);
}

void loop() { vTaskDelete(NULL); }
