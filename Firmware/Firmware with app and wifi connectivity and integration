// --- Position Update (ESP-NOW receiver) ---
static void PositionUpdateTask(void *param) {
    (void)param;
    PositionPacket p;

    for (;;) {
        if (xQueueReceive(g_posQueue, &p, portMAX_DELAY) == pdTRUE) {

            if (!acceptPositionMeasurement(p)) {
                Serial.println("[UWB] Measurement rejected (gate fail)");
                WebSerial.println("[UWB] Rejected (gate)");
                continue;
            }

            g_robot = {p.x, p.y, p.t_ms};

            xSemaphoreTake(g_posMutex, portMAX_DELAY);
            posBuffer[g_posHead] = {p.x, p.y, p.t_ms};
            int last = g_posHead;
            g_posHead = (g_posHead + 1) % SAMPLE_COUNT;
            if (g_posCount < SAMPLE_COUNT) g_posCount++;
            xSemaphoreGive(g_posMutex);

            correctEstimateWithUWB();

            Serial.printf("[UWB] raw=(%.3f,%.3f)  est=(%.3f,%.3f)  hdg=%.3f\n",
                p.x, p.y, g_est.est_x, g_est.est_y, g_est.est_heading);
            WebSerial.printf("UWB(%.3f,%.3f) Est(%.3f,%.3f) Hdg=%.3f\n",
                p.x, p.y, g_est.est_x, g_est.est_y, g_est.est_heading);
        }
    }
}

// --- Odometry + State Machine ---
static void odometryTask(void *param) {
    (void)param;

    for (;;) {
        updateDeadReckoning();

        if (g_isMowing && !obstacleStop) {
            switch (g_state) {

                case STATE_IDLE:
                    g_state = STATE_DRIVING;
                    break;

                case STATE_DRIVING: {
                    if (waypoint_index >= num_waypoints) {
                        moveFunction(STOP, 0);
                        g_isMowing = false;
                        g_state    = STATE_IDLE;
                        Serial.println("[NAV] All waypoints complete.");
                        WebSerial.println("[NAV] All waypoints complete.");
                        break;
                    }

                    xSemaphoreTake(g_posMutex, portMAX_DELAY);
                    float x = g_est.est_x, y = g_est.est_y, h = g_est.est_heading;
                    xSemaphoreGive(g_posMutex);

                    waypoint wp = nav_waypoints[waypoint_index];
                    float dist  = distanceToWaypoint(x, y, wp);

                    if (dist < 0.1f) {
                        moveFunction(STOP, 0);
                        Serial.printf("[NAV] Reached WP %d (%.3f,%.3f) hdg=%.3f\n",
                                      waypoint_index, x, y, h);
                        WebSerial.printf("WP %d reached. Hdg=%.3f\n", waypoint_index, h);
                        g_state = STATE_SETTLING;
                    } else {
                        navigateToWaypoint(x, y, h);
                    }
                    break;
                }

                case STATE_SETTLING:
                    // Pause 1 s at waypoint before advancing
                    vTaskDelay(pdMS_TO_TICKS(1000));
                    g_state = STATE_CORRECTING;
                    break;

                case STATE_CORRECTING:
                    waypoint_index++;
                    Serial.printf("[NAV] Advancing → WP %d / %d\n",
                                  waypoint_index, num_waypoints);
                    WebSerial.printf("Next WP: %d / %d\n",
                                     waypoint_index, num_waypoints);
                    if (waypoint_index >= num_waypoints) {
                        g_isMowing = false;
                        g_state    = STATE_IDLE;
                    } else {
                        g_state = STATE_DRIVING;
                    }
                    break;

                case STATE_CALIBRATING:
                    // Spin is initiated by /api/command calibrate
                    // and runs until the app sends pause or resume
                    break;
            }
        } else {
            moveFunction(STOP, 0);
        }

        vTaskDelay(pdMS_TO_TICKS(20));
    }
}

// --- Ultrasonic ---
static void ultrasonicTask(void *param) {
    (void)param;

    for (;;) {
        digitalWrite(US_TRIG_PIN, LOW);  delayMicroseconds(3);
        digitalWrite(US_TRIG_PIN, HIGH); delayMicroseconds(10);
        digitalWrite(US_TRIG_PIN, LOW);

        long  dur  = pulseIn(US_ECHO_PIN, HIGH, 12000);
        float dist = (dur * 0.0343f) / 2.0f / 100.0f;   // metres

        bool hit = (dur > 0 && dist <= 0.5f);

        if (hit && !obstacleStop) {
            Serial.printf("[US] Obstacle at %.2fm — halting\n", dist);
            WebSerial.printf("[US] Obstacle %.2fm\n", dist);
        }

        obstacleStop = hit;
        vTaskDelay(pdMS_TO_TICKS(100));
    }
}

